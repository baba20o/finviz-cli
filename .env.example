# Copy this file to .env and put your Finviz Elite API token after the equals sign.
# The token is shown on https://elite.finviz.com/apis when you are signed in.
#
# finviz looks for a .env in the folder you run it from, and then in its data folder
# (~/.finviz-cli/.env), which works from anywhere. Never commit your .env.
FINVIZ_API_KEY=
